# Anthropic API-Key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optionales Modell-Override (Standard: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Pfade zu den Gmail-OAuth-Dateien (siehe README.md)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Wie viele Mails pro Lauf maximal verarbeitet werden
MAX_EMAILS_PER_RUN=20

# Wohin die Analyse-Ergebnisse geloggt werden
MAIL_ASSISTANT_LOG=logs/analysis_log.jsonl
